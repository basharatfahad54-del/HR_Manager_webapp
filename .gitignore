New-Item -ItemType File -Path ".gitignore" -Value @'
# .env
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Backend
backend/venv/
backend/.venv/
backend/db.sqlite3
backend/hr.db

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# n8n
n8n_data/
workflows/*.backup.json

# Docker
.dockerignore
Dockerfile.*

# IDE/VS Code
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable

# Logs
*.log
logs/

# Temp
*.tmp
temp/
tmp/
'@ -Force; Write-Host ".gitignore created!" -ForegroundColor Green
